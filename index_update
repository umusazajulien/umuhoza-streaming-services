        // HERO CAROUSEL ROTATION
        const heroData = moviesData.filter(m => m.trending);
        
        function updateHero(index) {
            const movie = heroData[index];
            if (!movie) return;
            document.getElementById('hero-bg').src = movie.backdrop;
            document.getElementById('hero-title').innerText = movie.title;
            document.getElementById('hero-synopsis').innerText = movie.synopsis;
            document.getElementById('hero-rating').innerText = `IMDb ${movie.rating}`;
