        function renderGrid() {
            const movieGrid = document.getElementById('movie-grid');
            const noResults = document.getElementById('no-results');
            const resultsCount = document.getElementById('results-count');
            if (!movieGrid) return;

            let filtered = moviesData;

            // Category Filter
            if (activeCategory !== "All") {
                if (activeCategory === "Trending Now") {
                    filtered = filtered.filter(m => m.trending);
                } else {
                    filtered = filtered.filter(m => m.category === activeCategory || m.genres.includes(activeCategory));
                }
            }

            // Search Query Filter
            if (searchQuery.trim() !== "") {
                const q = searchQuery.toLowerCase();
                filtered = filtered.filter(m => 
                    m.title.toLowerCase().includes(q) || 
                    m.category.toLowerCase().includes(q) ||
                    m.genres.some(g => g.toLowerCase().includes(q))
                );
            }

            if (resultsCount) resultsCount.innerText = filtered.length;

            if (filtered.length === 0) {
                movieGrid.innerHTML = '';
                if (noResults) noResults.classList.remove('hidden');
                return;
            }

            if (noResults) noResults.classList.add('hidden');
            const watchTrailerText = translations[currentLang]?.watchTrailer || 'Watch Trailer';

            movieGrid.innerHTML = filtered.map(movie => {
                const badgeClass = movie.badge === '4K' ? 'badge-4k' : 'badge-hd';
                return `
                <div class="fmovie-card relative group rounded-2xl overflow-hidden bg-dark-900 border border-slate-800/80 cursor-pointer flex flex-col h-full shadow-lg" onclick="openModalById(${movie.id})">
                    
                    <!-- Poster Container (2:3 Aspect Ratio) -->
                    <div class="relative aspect-[2/3] w-full overflow-hidden bg-slate-900 shrink-0">
                        <img src="${movie.poster}" alt="${movie.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        
                        <!-- FMovies Quality Badge (Top Left) -->
                        <div class="absolute top-2 left-2 z-10">
                            <span class="px-2 py-0.5 rounded text-[10px] tracking-wide shadow-md ${badgeClass}">
                                ${movie.badge}
                            </span>
                        </div>

                        <!-- IMDb Rating Badge (Top Right) -->
                        <div class="absolute top-2 right-2 z-10">
                            <span class="px-2 py-0.5 rounded-md bg-black/75 backdrop-blur-md text-[10px] font-bold text-amber-400 border border-amber-400/30 flex items-center gap-1">
                                <i class="fa-solid fa-star text-[9px]"></i> ${movie.rating}
                            </span>
                        </div>

                        <!-- FMovies Play Overlay on Hover -->
                        <div class="absolute inset-0 bg-dark-950/70 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center gap-2 p-3 text-center">
                            <div class="w-12 h-12 rounded-full bg-brand-500 text-white flex items-center justify-center shadow-lg shadow-brand-500/40 transform scale-75 group-hover:scale-100 transition-transform duration-300">
                                <i class="fa-solid fa-play ml-1 text-base"></i>
                            </div>
                            <span class="text-xs font-bold text-white tracking-wide">${watchTrailerText}</span>
                            <span class="text-[10px] text-slate-300">${movie.duration}</span>
                        </div>
                    </div>

                    <!-- Bottom Info Box -->
                    <div class="p-2.5 sm:p-3 bg-dark-900 flex-grow flex flex-col justify-between">
                        <div>
                            <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-brand-400 transition-colors line-clamp-1 leading-snug">${movie.title}</h3>
                            <p class="text-[11px] font-medium text-brand-400/90 mt-0.5 tracking-tight line-clamp-1">${movie.category}</p>
                        </div>
                        <div class="flex items-center justify-between text-[10px] text-slate-400 mt-2 border-t border-slate-800/80 pt-2">
                            <span>${movie.year}</span>
                            <span class="text-slate-300 font-semibold">${movie.quality}</span>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        // CATEGORY PILLS FILTER HANDLER
        const categoryPills = document.querySelectorAll('.cat-btn');
        categoryPills.forEach(btn => {
            btn.addEventListener('click', () => {
                categoryPills.forEach(b => {
                    b.className = 'cat-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap bg-dark-800 hover:bg-dark-700 text-slate-300 border border-slate-700/60 transition-all';
