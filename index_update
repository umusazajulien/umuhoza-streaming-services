        // SEARCH INPUT FILTERING
        function handleSearchInput(e) {
            searchQuery = e.target.value;
            const clearSearchBtn = document.getElementById('clear-search');
            if (clearSearchBtn) {
                if (searchQuery.trim() !== '') {
                    clearSearchBtn.classList.remove('hidden');
