        function openModalById(id) {
            const movie = moviesData.find(m => m.id === id);
            if (movie) openModal(movie);
        }

        function openModal(movie) {
            const movieModal = document.getElementById('movie-modal');
            const modalBackdrop = document.getElementById('modal-backdrop');
            const modalTitle = document.getElementById('modal-title');
            const modalSynopsis = document.getElementById('modal-synopsis');
            const modalDirector = document.getElementById('modal-director');
            const modalCast = document.getElementById('modal-cast');
            const modalGenresText = document.getElementById('modal-genres-text');
            const modalMatch = document.getElementById('modal-match');
            const modalYear = document.getElementById('modal-year');
            const modalDuration = document.getElementById('modal-duration');
            const modalQuality = document.getElementById('modal-quality');
            const modalRelatedGrid = document.getElementById('modal-related-grid');

            if (modalBackdrop) modalBackdrop.src = movie.backdrop;
            if (modalTitle) modalTitle.innerText = movie.title;
            if (modalSynopsis) modalSynopsis.innerText = movie.synopsis;
            if (modalDirector) modalDirector.innerText = movie.director;
            if (modalCast) modalCast.innerText = movie.cast;
            if (modalGenresText) modalGenresText.innerText = movie.genres.join(', ');
            if (modalMatch) modalMatch.innerText = `${Math.floor(movie.rating * 10)}% Match`;
            if (modalYear) modalYear.innerText = movie.year;
            if (modalDuration) modalDuration.innerText = movie.duration;
            if (modalQuality) modalQuality.innerText = movie.quality;

            // Related Content
            if (modalRelatedGrid) {
                const related = moviesData.filter(m => m.id !== movie.id).slice(0, 3);
                modalRelatedGrid.innerHTML = related.map(rel => `
                    <div class="cursor-pointer group rounded-xl overflow-hidden bg-slate-900 border border-slate-800" onclick="openModalById(${rel.id})">
                        <img src="${rel.poster}" alt="${rel.title}" class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300">
                        <div class="p-2 text-[10px]">
                            <span class="font-bold text-white line-clamp-1">${rel.title}</span>
                            <span class="text-amber-400 font-semibold">★ ${rel.rating}</span>
                        </div>
                    </div>
                `).join('');
            }

            isVideoPlaying = false;
            updatePlayState();

            if (movieModal) movieModal.classList.remove('hidden');
        }

        const closeModalBtn = document.getElementById('close-modal');
        const movieModal = document.getElementById('movie-modal');
        if (closeModalBtn && movieModal) {
            closeModalBtn.addEventListener('click', () => {
                movieModal.classList.add('hidden');
                isVideoPlaying = false;
            });
            movieModal.addEventListener('click', (e) => {
                if (e.target === movieModal) movieModal.classList.add('hidden');
            });
        }

        function updatePlayState() {
            const playIcon = document.getElementById('modal-play-icon');
            const miniPlayIcon = document.getElementById('mini-play-icon');
            const overlay = document.getElementById('modal-video-overlay');
            if (isVideoPlaying) {
                if (playIcon) playIcon.className = 'fa-solid fa-pause text-2xl';
                if (miniPlayIcon) miniPlayIcon.className = 'fa-solid fa-pause';
                if (overlay) overlay.classList.add('opacity-0');
            } else {
                if (playIcon) playIcon.className = 'fa-solid fa-play text-2xl ml-1';
                if (miniPlayIcon) miniPlayIcon.className = 'fa-solid fa-play';
                if (overlay) overlay.classList.remove('opacity-0');
            }
        }

        const modalPlayTrigger = document.getElementById('modal-play-trigger');
        if (modalPlayTrigger) {
            modalPlayTrigger.addEventListener('click', () => {
                isVideoPlaying = !isVideoPlaying;
                updatePlayState();
                if (isVideoPlaying) showToast('▶ Streaming in 4K Ultra HD');
            });
        }

        const controlPlayBtn = document.getElementById('control-play-btn');
        if (controlPlayBtn) {
            controlPlayBtn.addEventListener('click', () => {
                isVideoPlaying = !isVideoPlaying;
                updatePlayState();
            });
        }

        // FAQ ACCORDION EXPANSION
        document.querySelectorAll('.faq-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const faqItem = button.closest('.faq-item');
                const faqContent = faqItem.querySelector('.faq-content');
                const icon = button.querySelector('i');

                const isHidden = faqContent.classList.contains('hidden');

                document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
                document.querySelectorAll('.faq-toggle i').forEach(i => i.classList.remove('rotate-180'));

                if (isHidden) {
                    faqContent.classList.remove('hidden');
                    icon.classList.add('rotate-180');
                }
            });
        });

        // FORM TRIAL SUBMISSION
        const trialForm = document.getElementById('trial-form');
        if (trialForm) {
            trialForm.addEventListener('submit', (e) => {
                e.preventDefault();
                showToast('🎉 Free account registration link sent to your email!');
                e.target.reset();
            });
        }

        // TOAST NOTIFICATIONS
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            if (!toast || !toastMsg) return;

            toastMsg.innerText = message;
            toast.classList.remove('hidden');

            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        // INITIALIZATION ON PAGE LOAD
        window.onload = function() {
            updateHero(0);
            renderGrid();
            changeLanguage(currentLang);
        };
    </script>
</body>
</html>
