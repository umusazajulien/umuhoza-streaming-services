            if (playBtn) playBtn.onclick = () => openModal(movie);

            // Render Hero Strip Thumbnails
            const thumbContainer = document.getElementById('hero-thumbnails');
            if (thumbContainer) {
                thumbContainer.innerHTML = heroData.map((m, i) => `
                    <div onclick="setHero(${i})" class="relative shrink-0 w-20 sm:w-22 aspect-[2/3] rounded-xl overflow-hidden cursor-pointer transition-all duration-300 ${i === index ? 'ring-2 ring-brand-500 scale-105 shadow-lg shadow-brand-500/30' : 'opacity-60 hover:opacity-100 hover:scale-95'}">
