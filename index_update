            if (genreBox) {
                genreBox.innerHTML = movie.genres.map(g => 
                    `<span class="px-3 py-1 rounded-full text-xs font-semibold bg-dark-800/90 border border-slate-700 text-slate-100 shadow-sm">${g}</span>`
                ).join('');
